# Supabase(Postgres) - Project Settings > Database > Connection string (Transaction pooler, port 6543)
SUPABASE_DB_URL=postgres://user:password@host:6543/postgres

# Google Drive連携
# ローカル版と同じGoogle Cloudプロジェクトの値を再利用可(その場合、Google Cloud ConsoleのOAuthクライアントに
# リダイレクトURI https://mojioko.vercel.app/api/drive/oauth2callback を追加登録すること)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# 簡易パスワードロック(未設定なら認証なし)
APP_PASSWORD=
